@inject Db Db
@{
    // values that every page can set at the top
    string title = ViewData["Title"] as string ?? "Dashboard";
    string subtitle = ViewData["Subtitle"] as string ?? "";

    // who is logged in (read from the database, so a new name or photo shows at once)
    User? me = Db.GetUser(User.FindFirstValue(ClaimTypes.NameIdentifier));
    string userName = me != null ? me.Name : (User.Identity?.Name ?? "Guest");
    string role = User.FindFirstValue(ClaimTypes.Role) ?? "";
    string firstLetter = me != null ? me.FirstLetter() : "?";
    string photoUrl = me != null ? me.PhotoUrl : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title - CareNexus</title>
    <link rel="icon" type="image/svg+xml" href="~/img/favicon.svg" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/healthcare.css" asp-append-version="true" />
</head>
<body class="app-body">

    <!-- left menu -->
    <partial name="_Sidebar" />

    <main class="main-area">
        <!-- top bar: page title + logged in user -->
        <header class="topbar">
            <div>
                <h1>@title</h1>
                @if (subtitle != "")
                {
                    <p>@subtitle</p>
                }
            </div>
            <a class="user-chip text-decoration-none text-reset" asp-controller="Profile" asp-action="Index" title="My profile">
                @if (photoUrl != "")
                {
                    <img class="avatar avatar-photo" src="@photoUrl" alt="@userName" />
                }
                else
                {
                    <span class="avatar">@firstLetter</span>
                }
                <span>
                    <b>@userName</b>
                    <small>@role portal@(me != null && me.LoginId != "" ? " · ID " + me.LoginId : "")</small>
                </span>
            </a>
        </header>

        <!-- the page itself -->
        <section class="page-content">
            <partial name="_Alerts" />
            @RenderBody()
        </section>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

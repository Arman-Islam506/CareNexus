@model List<ReportCheck>
@{
    ViewData["Title"] = "My Reports";
    ViewData["Subtitle"] = "Your saved report checks — view, print or delete";
}

<div class="toolbar">
    <a class="btn btn-teal" asp-action="ReportChecker">+ Check a new report</a>
</div>

<div class="panel">
    @if (Model.Count == 0)
    {
        <p class="muted mb-0">No saved reports yet. Every report you check in Report Checker is saved here.</p>
    }
    else
    {
        <table class="table align-middle">
            <thead>
                <tr><th>Date</th><th>Report</th><th>Values</th><th>Result</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (ReportCheck r in Model)
                {
                    int notNormal = r.NotNormalCount();
                    <tr>
                        <td>@Clock.LongDateTime(r.CreatedAt)</td>
                        <td>
                            @(r.FileName != "" ? r.FileName : "Typed values")
                            @if (r.ReadByAi)
                            {
                                <small class="status status-checkedin ms-1">AI</small>
                            }
                        </td>
                        <td>@r.Findings.Count</td>
                        <td>
                            @if (r.IsCritical)
                            {
                                <span class="status status-high">Very far from normal</span>
                            }
                            else if (notNormal > 0)
                            {
                                <span class="status status-low">@notNormal not normal</span>
                            }
                            else
                            {
                                <span class="status status-normal">All normal</span>
                            }
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-teal" asp-action="ReportView" asp-route-id="@r.Id">View &amp; print</a>
                            <form class="d-inline" method="post" asp-action="DeleteReport" asp-route-id="@r.Id"
                                  onsubmit="return confirm('Delete this report?');">
                                <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

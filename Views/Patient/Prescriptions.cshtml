@model List<Prescription>
@inject Db Db
@{
    ViewData["Title"] = "Prescriptions";
    ViewData["Subtitle"] = "Prescriptions written by your doctors";
}

<div class="panel">
    @if (Model.Count == 0)
    {
        <p class="muted mb-0">No prescriptions yet. They will appear here after your doctor writes one.</p>
    }
    else
    {
        <table class="table align-middle">
            <thead>
                <tr><th>Date</th><th>Doctor</th><th>Department</th><th>Diagnosis</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (Prescription p in Model)
                {
                    User? doctor = Db.GetUser(p.DoctorId);
                    <tr>
                        <td>@Clock.LongDateTime(p.CreatedAt)</td>
                        <td>@(doctor?.Name ?? "—")</td>
                        <td>@Db.DepartmentName(doctor?.DepartmentId)</td>
                        <td>@p.Diagnosis</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-teal" asp-action="PrescriptionView" asp-route-id="@p.Id">View &amp; print</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

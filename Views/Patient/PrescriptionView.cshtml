@model Prescription
@{
    ViewData["Title"] = "Prescription";
    ViewData["Subtitle"] = "View and print";
}

<div class="toolbar no-print">
    <a class="btn btn-outline-teal" asp-action="Prescriptions">← Back</a>
    <button class="btn btn-teal" type="button" onclick="window.print()">Print</button>
</div>

<partial name="_PrescriptionPaper" model="Model" />

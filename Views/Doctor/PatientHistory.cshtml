@model List<QueueRow>
@inject Db Db
@{
    ViewData["Title"] = "Patient History";
    ViewData["Subtitle"] = "All serials with you — search by patient ID, name, phone or email";

    string? search = ViewBag.Search;

    int patients = Model.Select(r => r.Serial.PatientId).Distinct().Count();
    int visited = Model.Count(r => r.Serial.Status == SerialStatus.Done);
    int absent = Model.Count(r => r.Serial.Status == SerialStatus.Absent);
    int upcoming = Model.Count - visited - absent;
}

<form class="toolbar" method="get">
    <input class="form-control search" name="search" value="@search" placeholder="ID (e.g. 101), name, phone or email" />
    <button class="btn btn-teal" type="submit">Search</button>
    @if (!string.IsNullOrEmpty(search))
    {
        <a class="btn btn-outline-teal" asp-action="PatientHistory">Clear</a>
    }
</form>

<div class="stats-grid">
    <div class="stat-card"><span>Patients</span><strong>@patients</strong><small>In this result</small></div>
    <div class="stat-card"><span>Visited</span><strong>@visited</strong><small>Completed sessions</small></div>
    <div class="stat-card"><span>Absent</span><strong>@absent</strong><small>Did not come</small></div>
    <div class="stat-card"><span>Upcoming</span><strong>@upcoming</strong><small>Not seen yet</small></div>
</div>

<div class="panel">
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr><th>Date</th><th>Serial</th><th>Patient</th><th>Chamber</th><th>Problem</th><th>Status</th><th>Fee</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (QueueRow row in Model)
                {
                    Serial s = row.Serial;
                    Chamber? c = Db.GetChamber(s.ChamberId);
                    <tr>
                        <td>@Clock.LongDate(s.Date)</td>
                        <td>#@s.SerialNo</td>
                        <td>@row.PatientName<small class="d-block muted">ID @row.PatientLoginId · @row.PatientPhone</small></td>
                        <td>@(c != null ? c.Title() : "—")</td>
                        <td>@s.Problem</td>
                        <td><span class="@s.CssClass()">@s.Label()</span></td>
                        <td>@Clock.Taka(s.Fee)</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-teal" asp-action="Prescription" asp-route-serialId="@s.Id">
                                @(row.HasPrescription ? "View Rx" : "Prescribe")
                            </a>
                        </td>
                    </tr>
                }
                @if (Model.Count == 0)
                {
                    <tr><td colspan="8" class="muted text-center py-4">No serials found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@model RegisterViewModel
@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Register";
}

<div class="login-shell">

    <!-- left side: about CareNexus -->
    <section class="login-brand">
        <div class="brand">
            <span class="login-logo"><partial name="_LogoMark" model="40" /></span>
            <span>Care<span class="brand-accent">Nexus</span></span>
        </div>
        <p class="login-title">Smart Healthcare Management Platform<br />with AI-Based Medical Report Analysis</p>
        <h1>Book your serial.<br />Skip the crowd.</h1>
        <p>Create a free patient account to take serials, see your live waiting time and keep your prescriptions in one place.</p>
    </section>

    <!-- right side: register form -->
    <section class="login-panel">
        <form class="login-card" method="post" asp-action="Register">
            <h2>Create account</h2>
            <p class="muted">For patients</p>

            <div asp-validation-summary="ModelOnly" class="text-danger small"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" placeholder="you@example.com" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Phone" class="form-label"></label>
                <input asp-for="Phone" class="form-control" placeholder="01XXXXXXXXX" />
                <span asp-validation-for="Phone" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" inputmode="numeric" maxlength="4" placeholder="4 digits" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" inputmode="numeric" maxlength="4" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>

            <button class="btn btn-teal w-100" type="submit">Create account</button>

            <p class="muted small mt-3 mb-0 text-center">
                Already have an account? <a asp-action="Login">Log in</a>
            </p>
        </form>
    </section>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }

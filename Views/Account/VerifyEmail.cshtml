@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Verify email";
    string email = ViewBag.Email;
}

<div class="login-shell">

    <!-- left side: about CareNexus -->
    <section class="login-brand">
        <div class="brand">
            <span class="login-logo"><partial name="_LogoMark" model="40" /></span>
            <span>Care<span class="brand-accent">Nexus</span></span>
        </div>
        <p class="login-title">Smart Healthcare Management Platform<br />with AI-Based Medical Report Analysis</p>
        <h1>One last step.</h1>
        <p>We sent a 6-digit code to your email. Type it here to activate your account.</p>
    </section>

    <!-- right side: code form -->
    <section class="login-panel">
        <div class="login-card">
            <h2>Verify your email</h2>
            <p class="muted">Code sent to <b>@email</b></p>

            <partial name="_Alerts" />

            <form method="post" asp-action="VerifyEmail">
                <input type="hidden" name="email" value="@email" />

                <label class="form-label" for="code">Verification code</label>
                <input class="form-control text-center fs-4" id="code" name="code" required
                       maxlength="6" inputmode="numeric" autocomplete="one-time-code" placeholder="••••••" />

                <button class="btn btn-teal w-100 mt-3" type="submit">Verify</button>
            </form>

            <!-- separate small form for "send again" -->
            <form method="post" asp-action="ResendCode" class="mt-3 text-center">
                <input type="hidden" name="email" value="@email" />
                <button class="btn btn-link" type="submit">Send a new code</button>
            </form>

            <p class="muted small mt-2 mb-0 text-center">
                Can't find it? Check your Spam folder. <a asp-action="Login">Back to log in</a>
            </p>
        </div>
    </section>
</div>

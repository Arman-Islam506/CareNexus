@model List<Chamber>
@inject Db Db
@{
    ViewData["Title"] = "Schedules";
    ViewData["Subtitle"] = "Chamber schedule of every doctor at " + HospitalInfo.Name;
    List<User> doctors = ViewBag.Doctors;
}

<div class="panel">
    <h2>Add chamber</h2>
    <form method="post" asp-action="AddChamber" class="row g-3">
        <div class="col-md-4">
            <label class="form-label" for="doctorId">Doctor</label>
            <select class="form-select" id="doctorId" name="doctorId" required>
                <option value="">Select doctor</option>
                @foreach (User d in doctors)
                {
                    <option value="@d.Id">@d.Name</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label" for="room">Room</label>
            <input class="form-control" id="room" name="room" placeholder="Room 201" />
        </div>
        <div class="col-md-6">
            <label class="form-label d-block">Days</label>
            @foreach (string day in Chamber.AllDays)
            {
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" name="days" id="day-@day" value="@day" />
                    <label class="form-check-label" for="day-@day">@day</label>
                </div>
            }
        </div>
        <div class="col-md-3">
            <label class="form-label" for="startTime">Start</label>
            <input class="form-control" id="startTime" name="startTime" type="time" value="09:00" required />
        </div>
        <div class="col-md-3">
            <label class="form-label" for="endTime">End</label>
            <input class="form-control" id="endTime" name="endTime" type="time" value="12:00" required />
        </div>
        <div class="col-12">
            <button class="btn btn-teal" type="submit">Add chamber</button>
        </div>
    </form>
</div>

<div class="panel">
    <table class="table align-middle">
        <thead><tr><th>Doctor</th><th>Department</th><th>Room</th><th>Days</th><th>Time</th><th></th></tr></thead>
        <tbody>
            @foreach (Chamber c in Model)
            {
                User? doctor = Db.GetUser(c.DoctorId);
                <tr>
                    <td><b>@(doctor?.Name ?? "—")</b></td>
                    <td>@Db.DepartmentName(doctor?.DepartmentId)</td>
                    <td>@c.Room</td>
                    <td>@c.DaysText()</td>
                    <td>@c.TimeText()</td>
                    <td class="text-end">
                        <form method="post" asp-action="DeleteChamber" onsubmit="return confirm('Delete this chamber?');">
                            <input type="hidden" name="id" value="@c.Id" />
                            <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                        </form>
                    </td>
                </tr>
            }
            @if (Model.Count == 0)
            {
                <tr><td colspan="7" class="muted text-center py-4">No chambers yet.</td></tr>
            }
        </tbody>
    </table>
</div>
